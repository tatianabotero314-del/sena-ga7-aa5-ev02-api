        "description": "Resultado esperado: HTTP 200. Autenticación satisfactoria.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"usuario\": \"{{usuarioPrueba}}\",\n  \"contrasena\": \"Practica2026!\"\n}",
