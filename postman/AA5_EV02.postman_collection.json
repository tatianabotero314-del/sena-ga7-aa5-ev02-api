{
  "info": {
    "name": "SENA AA5-EV02 - Pruebas de registro y login",
    "description": "Laura Tatiana Ciro Botero. API real de AA5-EV01. Ejecutar en orden; el registro genera un nombre único. Diez peticiones, tres verificaciones por petición. Datos ficticios.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8080",
      "type": "string"
    },
    {
      "key": "usuarioPrueba",
      "value": "",
      "type": "string"
    },
    {
      "key": "semilla",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 Disponibilidad",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/salud",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "salud"
          ]
        },
        "description": "Resultado esperado: HTTP 200. disponible"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const datos = pm.response.json();",
              "pm.test(\"Respuesta esperada\", () => pm.expect(datos.estado).to.eql(\"disponible\"));",
              "pm.test(\"No expone claves ni hash\", () => { pm.expect(datos).not.to.have.property(\"contrasena\"); pm.expect(datos).not.to.have.property(\"password_hash\"); });"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "02 Registro correcto",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/registro",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "registro"
          ]
        },
        "description": "Resultado esperado: HTTP 201. Usuario registrado correctamente.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"usuario\": \"{{usuarioPrueba}}\",\n  \"contrasena\": \"Practica2026!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Cada registro usa un usuario nuevo para poder repetir la colección.",
              "const semilla = Date.now().toString();",
              "pm.collectionVariables.set(\"semilla\", semilla);",
              "pm.collectionVariables.set(\"usuarioPrueba\", \"taty.\" + semilla);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "const datos = pm.response.json();",
              "pm.test(\"Respuesta esperada\", () => pm.expect(datos.mensaje).to.eql(\"Usuario registrado correctamente.\"));",
              "pm.test(\"No expone claves ni hash\", () => { pm.expect(datos).not.to.have.property(\"contrasena\"); pm.expect(datos).not.to.have.property(\"password_hash\"); });"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "03 Inicio de sesion correcto",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
